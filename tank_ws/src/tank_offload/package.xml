<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.ros.org/wiki/package_format3" ?>
<package format="3">
  <name>tank_offload</name>
  <version>0.1.0</version>
  <description>The Tank Project — overflow-storage daemon: when /var/tank fills past threshold the Pi pushes cold files to the Nextcloud-backed VPS via rclone + WebDAV.</description>
  <maintainer email="you@example.com">The Tank Project</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tank_health</exec_depend>
  <exec_depend>tank_nas</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
