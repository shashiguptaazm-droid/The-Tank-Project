<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens=http://www.ros.org/wiki/package_format3 ?>
<package format="3">
  <name>tank_display</name>
  <version>0.1.0</version>
  <description>The Tank Project — face-emotion OLED display (SH1106 @ I²C 0x70)</description>
  <maintainer email="you@example.com">The Tank Project</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-luma.oled</exec_depend>
  <exec_depend>tank_assistant</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
