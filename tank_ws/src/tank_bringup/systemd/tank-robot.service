# The Tank Project — systemd unit.
#
# Install with:
#   sudo cp /path/to/the-tank-project/tank_ws/src/tank_bringup/systemd/tank-robot.service \
#           /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tank-robot.service
#   journalctl -fu tank-robot.service       # tail logs
#
# Customize the WorkingDirectory and User= lines below for your install.

[Unit]
Description=The Tank Project — ROS2 Humble bring-up
Documentation=https://github.com/your-org/the-tank-project
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/the-tank-project/tank_ws
ExecStart=/bin/bash -lc "source /opt/ros/humble/setup.bash && source /home/pi/the-tank-project/tank_ws/install/setup.bash && exec ros2 launch tank_bringup robot.launch.py"
Restart=on-failure
RestartSec=3
# RoS log
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
