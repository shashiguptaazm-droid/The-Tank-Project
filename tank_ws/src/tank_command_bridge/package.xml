<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.ros.org/wiki/package_format3" ?>
<package format="3">
  <name>tank_command_bridge</name>
  <version>0.1.0</version>
  <description>The Tank Project — bidirectional command bridge for external AI coding assistants (Freebuff/Claude/Codex/etc.)</description>
  <maintainer email="you@example.com">The Tank Project</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tank_motion</exec_depend>
  <exec_depend>tank_health</exec_depend>
  <exec_depend>tank_dock</exec_depend>
  <exec_depend>tank_patrol</exec_depend>
  <exec_depend>tank_security</exec_depend>
  <exec_depend>tank_meta</exec_depend>
  <exec_depend>tank_assistant</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
