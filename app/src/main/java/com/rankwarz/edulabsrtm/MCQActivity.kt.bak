    private class QuestionPickerAdapter(
        context: Context,
        private val questions: List<Int>,
        private val prefs: android.content.SharedPreferences
    ) : ArrayAdapter<Int>(context, android.R.layout.simple_list_item_1, questions) {

        override fun getView(position: Int, convertView: View?, parent: ViewGroup): View {
            val view = super.getView(position, convertView, parent) as TextView
            val qId = questions[position]
            val savedAns = prefs.getString("q_$qId", null)

            // Check if correct/incorrect from stored metadata if available,
            // or just green if attempted.
            // For simplicity here, we use attempted (green) vs not (red)
            // and check the "correct" status if we can verify it.

            view.text = "Question ${position + 1}"

if (savedAns != null) {
                 // Attempted = Green with checkmark
                 view.setTextColor(Color.parseColor("#4CAF50"))
                 view.setCompoundDrawablesWithIntrinsicBounds(0, 0, android.R.drawable.checkbox_on_background, 0)
             } else {
                 // Not attempted = Red/Gray
                 view.setTextColor(Color.parseColor("#F44336"))
                 view.setCompoundDrawablesWithIntrinsicBounds(0, 0, 0, 0)
             }

            val padding = (16 * context.resources.displayMetrics.density).toInt()
            view.setPadding(padding, padding, padding, padding)

            return view
        }
    }

