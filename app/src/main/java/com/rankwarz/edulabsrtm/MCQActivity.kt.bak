    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_mcq)

        val prefs = getSharedPreferences("MY_APP", MODE_PRIVATE)
        val rawSubject = intent.getStringExtra("SELECTED_SUBJECT")
            ?: prefs.getString("selected_subject_preference", "General")
            ?: "General"
        currentSubject = rawSubject.replace(Regex("[^\\p{L}\\p{N}\\s]"), "").trim()
        userId = prefs.getInt("user_id", 0)
        currentExp = prefs.getInt("user_exp", 0)
        tts = TextToSpeech(this, this)
        vibrator = getSystemService(Context.VIBRATOR_SERVICE) as Vibrator

        val mode = intent.getStringExtra("MODE")
        if (mode == "SURVIVAL") {
            isSurvivalMode = true
            currentSubject = intent.getStringExtra("SELECTED_SUBJECT") ?: "NEET PG"
            currentTopic = intent.getStringExtra("SELECTED_TOPIC") ?: "Uncategorized"
        } else if (mode == "KING_OF_TOPIC") {
            isKingOfTopic = true
            isSurvivalMode = true // King of topic is a survival mode
            currentSubject = intent.getStringExtra("SELECTED_SUBJECT") ?: "NEET PG"
            currentTopic = intent.getStringExtra("SELECTED_TOPIC")
        } else if (mode == "TODAY_CHALLENGE") {
            isTodayChallenge = true
            currentSubject = "NEET PG"
            currentTopic = "Uncategorized"
            startChallengeTimer()
        }

        initViews()
        setupListeners()
        setupBottomNav()
        setupTopicSelection()
        setupGamingUI()

        val incomingIds = intent.getIntegerArrayListExtra("QUESTION_ID_LIST")
        if (incomingIds != null && incomingIds.isNotEmpty()) {
            isFixedTest = true
            allQuestionIds.addAll(incomingIds)
            Log.d(TAG, "Loaded fixed test with ${allQuestionIds.size} questions. First ID: ${allQuestionIds.getOrNull(0)}")
            topicLayout.visibility = View.GONE
            fetchQuestion(allQuestionIds[currentIndex])
        } else if (intent.hasExtra("question_id")) {
            // Support for single question intent override
            val singleId = readQuestionIdExtra()
            if (singleId > 0) {
                Log.d(TAG, "Loading single question ID: $singleId")
                isFixedTest = true
                allQuestionIds.add(singleId)
                topicLayout.visibility = View.GONE
                fetchQuestion(singleId)
            } else {
                Log.w(TAG, "Invalid question_id extra; loading default question flow")
                isFixedTest = false
                fetchTopics()
                fetchQuestion(null)
            }
        }else {
            isFixedTest = false
            fetchTopics()
            fetchQuestion(null)
        }
    }

    private fun readQuestionIdExtra(): Int {
        val value = intent.extras?.get("question_id") ?: return 0
        return when (value) {
            is Int -> value
            is Number -> value.toInt()
            is String -> value.toIntOrNull() ?: 0
            else -> 0
        }
    }

