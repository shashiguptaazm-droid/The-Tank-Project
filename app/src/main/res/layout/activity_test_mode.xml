<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ============================================================ -->
        <!--  Damage GIF overlay (center screen) – kept as original       -->
        <!--  Added glow tint & transition name for animations            -->
        <!-- ============================================================ -->
        <ImageView
            android:id="@+id/damageGif"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_centerInParent="true"
            android:visibility="gone"
            android:alpha="0"
            android:elevation="20dp"
            android:transitionName="damage_effect"
            tools:ignore="ContentDescription" />

        <!-- ============================================================ -->
        <!--  Battle Card – now MaterialCardView for neon stroke & depth -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/battleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp"
            app:strokeColor="#9C4DFF"
            app:strokeWidth="2dp"
            app:rippleColor="#9C4DFF"
            android:transitionName="battle_status_card"
            android:animateLayoutChanges="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvBattleStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BATTLE STATUS"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:textColor="#00E5FF"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:shadowColor="#00E5FF"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3" />

                    <ImageButton
                        android:id="@+id/btnBattleToggle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Collapse battle status"
                        android:padding="4dp"
                        android:src="@android:drawable/arrow_up_float"
                        app:tint="#00E5FF"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/challengeBattleHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:animateLayoutChanges="true" />

                <!-- Player rows are added here dynamically by code -->

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!--  Header Bar – glass effect, neon accents                     -->
        <!-- ============================================================ -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/battleCard"
            android:background="?attr/colorSurface"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:animateLayoutChanges="true">

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#00E5FF"
                tools:ignore="ContentDescription" />

            <!-- Question progress -->
            <TextView
                android:id="@+id/tvQuestionProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Q 1 / 15"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/timer_bg_rounded"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:shadowColor="#FFD54F"
                android:shadowRadius="2" />

            <!-- Status text (Round X of Y) -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Round 1 of 15"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#00E5FF"
                android:shadowRadius="2" />

            <!-- Streak counter -->
            <TextView
                android:id="@+id/tvStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text=""
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF6F00"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#FF6F00"
                android:shadowRadius="3"
                tools:text="🔥 x3" />

            <!-- Timer -->
            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/timer_bg_rounded"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="15:00"
                android:textColor="#E53935"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#FF1744"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!--  Main Scrollable Content – deep space background             -->
        <!-- ============================================================ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottomControlBar"
            android:layout_below="@id/headerBar"
            android:fillViewport="true"
            android:padding="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true">

                <!-- ============================================================ -->
                <!--  Power-ups Row – glowing icon buttons & cooldown labels      -->
                <!-- ============================================================ -->
                <LinearLayout
                    android:id="@+id/powersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:animateLayoutChanges="true">

                    <!-- Adrenaline -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:animateLayoutChanges="true">

                        <ImageButton
                            android:id="@+id/btnAdrenaline"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_power_adrenaline"
                            android:contentDescription="Adrenaline: +15 HP"
                            android:transitionName="power_adrenaline"
                            android:shadowColor="#00E5FF"
                            android:shadowRadius="4" />

                        <!-- Cooldown label -->
                        <TextView
                            android:id="@+id/tvAdrenalineCooldown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textSize="9sp"
                            android:textColor="#00C853"
                            android:textStyle="bold"
                            android:visibility="gone"
                            android:shadowColor="#00C853"
                            android:shadowRadius="1.5"
                            tools:text="Ready"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Shield -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:animateLayoutChanges="true">

                        <ImageButton
                            android:id="@+id/btnShield"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_power_shield"
                            android:contentDescription="Shield: block 2 hits"
                            android:transitionName="power_shield"
                            android:shadowColor="#00B0FF"
                            android:shadowRadius="4" />

                        <TextView
                            android:id="@+id/tvShieldCooldown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textSize="9sp"
                            android:textColor="#00B0FF"
                            android:textStyle="bold"
                            android:visibility="gone"
                            android:shadowColor="#00B0FF"
                            android:shadowRadius="1.5"
                            tools:text="Active: 2"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Shock -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:animateLayoutChanges="true">

                        <ImageButton
                            android:id="@+id/btnShock"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_power_shock"
                            android:contentDescription="Shock: 2x damage"
                            android:transitionName="power_shock"
                            android:shadowColor="#FFD600"
                            android:shadowRadius="4" />

                        <TextView
                            android:id="@+id/tvShockCooldown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textSize="9sp"
                            android:textColor="#FFD600"
                            android:textStyle="bold"
                            android:visibility="gone"
                            android:shadowColor="#FFD600"
                            android:shadowRadius="1.5"
                            tools:text="Charged⚡"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Confuse -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:animateLayoutChanges="true">

                        <ImageButton
                            android:id="@+id/btnConfuse"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_power_confuse"
                            android:contentDescription="Confuse: scramble a bot's answer"
                            android:transitionName="power_confuse"
                            android:shadowColor="#CE93D8"
                            android:shadowRadius="4" />

                        <TextView
                            android:id="@+id/tvConfuseCooldown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textSize="9sp"
                            android:textColor="#CE93D8"
                            android:textStyle="bold"
                            android:visibility="gone"
                            android:shadowColor="#CE93D8"
                            android:shadowRadius="1.5"
                            tools:text="Active!"
                            tools:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ============================================================ -->
                <!--  Divider – neon stroke                                      -->
                <!-- ============================================================ -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginBottom="16dp"
                    android:background="#1A1F38"
                    android:alpha="0.6" />

                <!-- ============================================================ -->
                <!--  Question Text – glowing neon edge, bold cyber font         -->
                <!-- ============================================================ -->
                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Question text will appear here..."
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="18sp"
                    android:lineSpacingExtra="6dp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#00E5FF"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:padding="4dp"
                    android:transitionName="question_text" />

                <!-- ============================================================ -->
                <!--  Question Image – neon bordered card                         -->
                <!-- ============================================================ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/imgCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#0B1023"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="2dp"
                    android:transitionName="question_image_container">

                    <ImageView
                        android:id="@+id/questionImageView"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        tools:ignore="ContentDescription" />
                </com.google.android.material.card.MaterialCardView>

                <!-- ============================================================ -->
                <!--  Options – radio buttons with gaming tint & shadows          -->
                <!-- ============================================================ -->
                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:animateLayoutChanges="true">

                    <RadioButton
                        android:id="@+id/optionA"
                        style="@style/PrepLadderOptionStyle"
                        android:text="Option A"
                        android:shadowColor="#BB86FC"
                        android:shadowRadius="2"
                        android:transitionName="option_a" />

                    <RadioButton
                        android:id="@+id/optionB"
                        style="@style/PrepLadderOptionStyle"
                        android:text="Option B"
                        android:shadowColor="#00E5FF"
                        android:shadowRadius="2"
                        android:transitionName="option_b" />

                    <RadioButton
                        android:id="@+id/optionC"
                        style="@style/PrepLadderOptionStyle"
                        android:text="Option C"
                        android:shadowColor="#56F78D"
                        android:shadowRadius="2"
                        android:transitionName="option_c" />

                    <RadioButton
                        android:id="@+id/optionD"
                        style="@style/PrepLadderOptionStyle"
                        android:text="Option D"
                        android:shadowColor="#FF7043"
                        android:shadowRadius="2"
                        android:transitionName="option_d" />

                </RadioGroup>

                <!-- ============================================================ -->
                <!--  Explanation / Feedback Box – holographic style               -->
                <!-- ============================================================ -->
                <LinearLayout
                    android:id="@+id/explanationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/explanation_bg_rounded"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    android:transitionName="explanation_box"
                    android:animateLayoutChanges="true"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/feedbackHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FEEDBACK"
                        android:textSize="12sp"
                        android:textColor="#00E5FF"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:shadowColor="#00E5FF"
                        android:shadowRadius="2" />

                    <TextView
                        android:id="@+id/explanationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="..."
                        android:lineSpacingExtra="4dp"
                        android:textColor="#E0E0FF" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ============================================================ -->
        <!--  Bottom Control Bar – glowing buttons, dark panel             -->
        <!-- ============================================================ -->
        <LinearLayout
            android:id="@+id/bottomControlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/navContainer"
            android:background="?attr/colorSurface"
            android:elevation="16dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:animateLayoutChanges="true">

            <!-- Submit button – now MaterialButton with glowing tint -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Submit Answer"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#00E5FF"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                app:backgroundTint="#2E7D32"
                app:cornerRadius="12dp"
                app:rippleColor="#00E5FF"
                android:transitionName="submit_button" />

            <!-- Secondary actions row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:animateLayoutChanges="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/prevBtn"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Previous"
                    android:textColor="#00E5FF"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#00E5FF"
                    android:shadowRadius="2"
                    app:rippleColor="#00E5FF"
                    android:transitionName="prev_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextBtn"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Skip"
                    android:textColor="#FFD54F"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#FFD54F"
                    android:shadowRadius="2"
                    app:rippleColor="#FFD54F"
                    android:transitionName="next_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/finalSubmitBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:text="Finish Test"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#FF1744"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    app:backgroundTint="#D32F2F"
                    app:cornerRadius="10dp"
                    app:rippleColor="#FF1744"
                    android:transitionName="finish_button" />

            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!--  Bottom Navigation – unchanged, just tidied                  -->
        <!-- ============================================================ -->
        <LinearLayout
            android:id="@+id/navContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#0D1120">
            <include layout="@layout/layout_navigation" />
        </LinearLayout>

    </RelativeLayout>

    <!-- ============================================================ -->
    <!--  Navigation Drawer – unchanged, left as original              -->
    <!-- ============================================================ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="?attr/colorOnSurface"
        app:itemTextColor="?attr/colorOnSurface"
        app:menu="@menu/sidebar_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
