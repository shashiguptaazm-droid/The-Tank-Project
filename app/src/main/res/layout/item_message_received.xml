<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="60dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/bubbleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_received"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <!-- AI Sender Header (WhatsApp Meta AI style) -->
        <LinearLayout
            android:id="@+id/aiHeaderLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/aiHeaderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 MediGyaan AI"
                android:textColor="#00A884"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Link Preview Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/linkPreviewCard"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_link_preview_received"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/linkThumb"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/linkDomain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:textColor="@color/whatsapp_bubble_received_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/linkTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/whatsapp_bubble_received_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/linkDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.75"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/whatsapp_bubble_received_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Media Container (Image / Video) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/mediaCard"
            android:layout_width="240dp"
            android:layout_height="200dp"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/messageImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Video NOT downloaded overlay (Download required before playback) -->
                <FrameLayout
                    android:id="@+id/videoDownloadOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#40000000"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="54dp"
                            android:layout_height="54dp">

                            <ImageView
                                android:id="@+id/icVideoDownloadCircle"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:src="@drawable/bg_download_circle" />

                            <ImageView
                                android:id="@+id/icVideoDownloadArrow"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_download"
                                app:tint="#FFFFFF" />

                            <ProgressBar
                                android:id="@+id/videoDownloadProgress"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:indeterminate="true"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/videoDownloadText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_video_duration"
                            android:text="Tap to Download"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Video DOWNLOADED overlay (Play button in center) -->
                <FrameLayout
                    android:id="@+id/videoPlayOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#15000000"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_circle_overlay" />

                    <TextView
                        android:id="@+id/videoDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_video_duration"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Save to device button (corner) -->
                <ImageButton
                    android:id="@+id/btnMediaDownload"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_download_circle"
                    android:src="@drawable/ic_download"
                    app:tint="#FFFFFF"
                    android:padding="6dp"
                    android:contentDescription="Save to Downloads" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Document Container (WhatsApp Style with 1st Page Preview Image) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/documentCard"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_document_card_received"
                android:orientation="vertical">

                <!-- 1st Page Preview Image -->
                <FrameLayout
                    android:id="@+id/docPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#10000000">

                    <ImageView
                        android:id="@+id/docThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/docTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_doc_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="PDF"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/docPageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_video_duration"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="1 page"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Document Info Footer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/docTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="2"
                            android:text="Document.pdf"
                            android:textColor="@color/whatsapp_bubble_received_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/docSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.7"
                            android:text="PDF • 2.4 MB"
                            android:textColor="@color/whatsapp_bubble_received_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnDocDownload"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Download"
                        android:padding="6dp"
                        android:src="@drawable/ic_download"
                        app:tint="@color/whatsapp_bubble_received_text" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Legacy fallback badge -->
        <TextView
            android:id="@+id/fileBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/askAiBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_ask_ai_btn"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="🤖 Ask AI"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="all"
            android:textColor="@color/whatsapp_bubble_received_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/messageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textColor="@color/whatsapp_bubble_received_text"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
