<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/widgetBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/expert_widget" />

    <!-- Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#55000000">

        <!-- Title Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEET PG"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/widgetProfileIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_settings"/>
        </LinearLayout>

        <!-- Days -->
        <TextView
            android:id="@+id/widgetDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12"
            android:textColor="#FFFFFF"
            android:textSize="92sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/widgetSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="days left"
            android:textColor="#CCCCCC"
            android:textSize="24sp"/>

        <!-- Stats -->
        <TextView
            android:id="@+id/widgetStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="40/100 MCQs done today"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_marginTop="8dp"/>

        <!-- Date -->
        <TextView
            android:id="@+id/widgetDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 Apr 2026"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</FrameLayout>