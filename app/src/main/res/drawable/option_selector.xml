<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/option_card_bg_selected"/>
            <stroke android:width="2dp" android:color="@color/option_card_stroke_selected"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/option_card_bg_default"/>
            <stroke android:width="1.5dp" android:color="@color/option_card_stroke_default"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
