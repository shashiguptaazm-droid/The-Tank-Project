# Tank — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# VPS AI Backend
TANK_VPS_URL=http://your-vps:8000
TANK_VPS_API_KEY=your-api-key-here

# Simulation / Demo
TANK_SIMULATION=true
TANK_DEMO_MODE=true

# Logging
TANK_LOG_LEVEL=INFO

# Dashboard
TANK_DASHBOARD_PORT=8080

# Hardware (Arduino UNO R4 WiFi)
TANK_ARDUINO_PORT=/dev/ttyACM0
TANK_ARDUINO_BAUD=115200

# Sensors
TANK_CAMERA_DEVICE=0
TANK_LIDAR_PORT=/dev/ttyUSB0
