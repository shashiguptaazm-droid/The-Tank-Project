# ╔══════════════════════════════════════════════════════════════╗
# ║  TankOS — Environment Configuration (Full Reference)        ║
# ║  Copy to .env and fill in values.                           ║
# ║  Never commit .env to version control.                      ║
# ║  Evolution system will prompt for missing keys at runtime.  ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── CORE ──────────────────────────────────────────────────
TANK_NAME=The Tank
TANK_ID=APC-2026-RJ-75818
TANK_VPS_URL=http://100.71.127.19:8888
TANK_VPS_API_KEY=your-vps-api-key
TANK_SIMULATION=true
TANK_DEMO_MODE=true
TANK_LOG_LEVEL=INFO
TANK_DASHBOARD_PORT=8080

# ─── ARDUINO UNO Q ────────────────────────────────────────
TANK_ARDUINO_PORT=/dev/ttyACM0
TANK_ARDUINO_BAUD=115200

# ─── SENSORS ──────────────────────────────────────────────
TANK_CAMERA_DEVICE=0
TANK_LIDAR_PORT=/dev/ttyUSB0
TANK_LIDAR_BAUD=115200

# ─── AI MODELS ────────────────────────────────────────────
TANK_YOLO_MODEL=yolov8n.pt
TANK_LLM_MODEL=Phi-3-mini-4k-instruct-Q4_K_M.gguf
TANK_WHISPER_MODEL=tiny

# ─── ESP32 SWARM ──────────────────────────────────────────
TANK_ESP32_EYES=/dev/ttyACM1
TANK_ESP32_HEAD=/dev/ttyUSB1
TANK_ESP32_CHEST=/dev/ttyUSB2

# ═══════════════════════════════════════════════════════════
#  CLOUD AI PROVIDER API KEYS
#  The evolution system discovers and evaluates these providers.
#  Missing keys are prompted at runtime during the evolution cycle.
#  Get free keys at the URLs below.
# ═══════════════════════════════════════════════════════════

# ─── OPENROUTER (Multi-Model Gateway) ─────────────────────
# Free tier: $5 credit. Models: GPT-4, Claude, Llama, Mistral
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── GROQ (Fastest Inference) ─────────────────────────────
# Free tier: Unlimited Llama/Mixtral requests
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# ─── GOOGLE GEMINI (Multimodal AI) ────────────────────────
# Free tier: 15 RPM Gemini Flash
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── MISTRAL AI (European LLM) ────────────────────────────
# Free tier: 1 RPM Mistral Small
# Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ─── CEREBRAS (Fastest LLM Inference) ─────────────────────
# Free tier: 30 RPM Llama 3.1 8B
# Get key: https://cloud.cerebras.ai/api-keys
CEREBRAS_API_KEY=

# ─── COHERE (Reranking + Chat) ────────────────────────────
# Free tier: 1000 RPM Command R
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ─── REPLICATE (Open-Source Models) ───────────────────────
# Free tier: $5 credit
# Get key: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=

# ─── HUGGING FACE (Model Hub + Inference API) ─────────────
# Free tier: 30K chars/month inference
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ─── CLOUDFLARE WORKERS AI (Edge AI) ──────────────────────
# Free tier: 10K requests/day
# Get key: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_WORKER_API_KEY=

# ═══════════════════════════════════════════════════════════
#  OPTIONAL KEYS (Advanced Features)
# ═══════════════════════════════════════════════════════════

# ─── OPENAI (GPT-4 Vision + DALL-E) ───────────────────────
# Free tier: $5 credit on signup
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── ANTHROPIC (Claude 3.5 Sonnet) ────────────────────────
# Free tier: $5 credit
# Get key: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=

# ─── TOGETHER AI (Open-Source Hosting) ────────────────────
# Free tier: $5 credit
# Get key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# ─── DEEPINFRA (Llama Inference) ──────────────────────────
# Free tier: $5 credit
# Get key: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# ─── SAMBANOVA (Fast Llama) ───────────────────────────────
# Free tier: Unlimited Llama 3 8B
# Get key: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# ─── TELEGRAM BOT ─────────────────────────────────────────
# Create bot: https://t.me/BotFather → /newbot
TANK_TELEGRAM_TOKEN=
TANK_TELEGRAM_CHAT_ID=

# ─── PUSHOVER (Mobile Notifications) ──────────────────────
# Get key: https://pushover.net/apps/build/
PUSHOVER_APP_KEY=
PUSHOVER_USER_KEY=

# ─── WEATHER API ──────────────────────────────────────────
# Free tier: 1000 calls/day
# Get key: https://www.weatherapi.com/signup.aspx
WEATHER_API_KEY=

# ─── MAPBOX (Advanced Navigation) ─────────────────────────
# Free tier: 100K loads/month
# Get key: https://account.mapbox.com/access-tokens
MAPBOX_ACCESS_TOKEN=

# ═══════════════════════════════════════════════════════════
#  EVOLUTION SYSTEM
#  The evolution cycle runs daily. It:
#  1. Checks which API keys are configured
#  2. Discovers new providers from the list above
#  3. Tests each provider with a benchmark query
#  4. Ranks providers by speed + quality
#  5. Rotates the best provider to primary
#  6. Reports results via SMS/Telegram
#
#  If a key is missing, the system will:
#  - Print the setup URL to the terminal
#  - Send you an SMS with the link
#  - Wait for you to paste the key
# ═══════════════════════════════════════════════════════════
TANK_EVOLUTION_ENABLED=true
TANK_EVOLUTION_SCHEDULE=daily
TANK_EVOLUTION_PRIMARY_PROVIDER=groq
TANK_EVOLUTION_FALLBACK_PROVIDER=openrouter
TANK_EVOLUTION_SMS_NOTIFY=true
TANK_EVOLUTION_SMS_NUMBER=+917860245819

# ═══════════════════════════════════════════════════════════
#  NETWORKING
# ═══════════════════════════════════════════════════════════
TANK_WIFI_SSID=AirFiber-X9nxU1
TANK_WIFI_PASSWORD=your-wifi-password
TANK_TAILSCALE_AUTH_KEY=your-tailscale-auth-key
TANK_LTE_APN=airtel
TANK_HOTSPOT_SSID=TANK-HOTSPOT
TANK_HOTSPOT_PASSWORD=tankos2026
