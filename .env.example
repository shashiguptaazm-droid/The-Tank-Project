# ╔══════════════════════════════════════════════════╗
# ║  Tank — Environment Configuration               ║
# ║  Copy to .env and fill in values.               ║
# ║  Never commit .env to version control.          ║
# ╚══════════════════════════════════════════════════╝

# ── VPS AI Backend ──────────────────────────────
TANK_VPS_URL=http://your-vps:8000
TANK_VPS_API_KEY=your-api-key-here

# ── Simulation / Demo ───────────────────────────
TANK_SIMULATION=true          # true = mock sensors, false = real hardware
TANK_DEMO_MODE=true           # true = deterministic demo sequence

# ── Logging ─────────────────────────────────────
TANK_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# ── Dashboard ───────────────────────────────────
TANK_DASHBOARD_PORT=8080

# ── Arduino UNO Q (ABX00173) ────────────────────
TANK_ARDUINO_PORT=/dev/ttyACM0
TANK_ARDUINO_BAUD=115200

# ── Sensors ─────────────────────────────────────
TANK_CAMERA_DEVICE=0          # /dev/videoN
TANK_LIDAR_PORT=/dev/ttyUSB0
TANK_LIDAR_BAUD=115200

# ── AI Models ───────────────────────────────────
TANK_YOLO_MODEL=yolov8n.pt
TANK_LLM_MODEL=Phi-3-mini-4k-instruct-Q4_K_M.gguf
TANK_WHISPER_MODEL=tiny

# ── ESP32 Swarm ─────────────────────────────────
TANK_ESP32_HEAD=/dev/ttyUSB1
TANK_ESP32_CHEST=/dev/ttyUSB2
TANK_ESP32_NECK=/dev/ttyUSB3
TANK_ESP32_HAND_L=/dev/ttyUSB4
TANK_ESP32_HAND_R=/dev/ttyUSB5
