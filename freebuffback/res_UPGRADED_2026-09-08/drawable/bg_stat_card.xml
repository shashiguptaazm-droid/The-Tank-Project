<ripple
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#335C6BC0">
    <item>
<shape android:shape="rectangle">

    <solid android:color="@android:color/white"/>

    <corners android:radius="18dp"/>

    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>

    <stroke
        android:width="1dp"
        android:color="#E0E0E0"/>

    </shape>
    </item>

</ripple>