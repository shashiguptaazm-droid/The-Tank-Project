    // ─── Companion ───────────────────────────────────────────────────────────

    companion object {

        @JvmStatic
        fun start(
            context: Context,
            challengeId: String,
            uniqueId: Int = 1,
            subject: String? = null,
            topic: String? = null,
            isHost: Boolean = true,
            isChallenge: Boolean = true,
            realMultiplayer: Boolean = true
        ) {
            val intent = Intent(context, ClassicGameActivity::class.java).apply {
                putExtra("CHALLENGE_ID",   challengeId)
                putExtra("UNIQUE_ID",      uniqueId)
                putExtra("IS_HOST",        isHost)
                putExtra("IS_CHALLENGE",   isChallenge)
                putExtra("REAL_MULTIPLAYER", realMultiplayer)
                subject?.let { putExtra("SUBJECT", it) }
                topic?.let   { putExtra("TOPIC",   it) }
            }
            context.startActivity(intent)
        }

        @JvmStatic
        fun start(
            context: Context,
            challengeId: Int,
            uniqueId: Int = 1,
            subject: String? = null,
            topic: String? = null,
            isHost: Boolean = true,
            isChallenge: Boolean = true
