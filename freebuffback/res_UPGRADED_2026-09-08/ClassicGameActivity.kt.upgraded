    // ─── Bot state ───────────────────────────────────────────────────────────

    private data class BotState(
        val id: String,
        val name: String,
        val skin: String,
        val baseAccuracy: Float,
        val minDelayMs: Long,
        val maxDelayMs: Long,
        val personality: BotPersonality = BotPersonality.STEADY,
        var hp: Int    = 100,
        var score: Int = 0,
        var finished: Boolean = false,
        var consecutiveCorrect: Int = 0,
        var consecutiveWrong:   Int = 0,
        var questionsAnswered:  Int = 0,
        var confusedThisRound:  Boolean = false
    ) {
        fun effectiveAccuracy(playerScore: Int, @Suppress("UNUSED_PARAMETER") playerHp: Int): Float {
            var acc = baseAccuracy
            when (personality) {
                BotPersonality.STREAKY -> {
                    if (consecutiveCorrect >= 3) acc = (acc + 0.15f).coerceAtMost(0.95f)
                    if (consecutiveWrong   >= 2) acc = (acc - 0.20f).coerceAtLeast(0.25f)
                }
                BotPersonality.CLUTCH -> {
                    acc = if (hp <= 40) (acc + 0.20f).coerceAtMost(0.95f)
                    else          (acc - 0.10f).coerceAtLeast(0.30f)
                }
                BotPersonality.TILTING -> {
                    acc = (acc - consecutiveWrong * 0.05f).coerceAtLeast(0.20f)
                    if (consecutiveCorrect >= 1) acc = baseAccuracy
                }
                BotPersonality.CATCH_UP -> {
                    val delta = score - playerScore
                    acc = when {
                        delta >  20 -> (acc - 0.15f).coerceAtLeast(0.35f)
                        delta < -20 -> (acc + 0.20f).coerceAtMost(0.95f)
                        else -> acc
                    }
                }
                BotPersonality.STEADY -> Unit
            }
            if (confusedThisRound) acc = (acc - 0.40f).coerceAtLeast(0.05f)
            return acc
        }

        fun effectiveDelay(rng: Random): Long {
            val base = minDelayMs + (rng.nextFloat() * (maxDelayMs - minDelayMs)).toLong()
            return when (personality) {
                BotPersonality.CLUTCH  -> if (hp <= 40) (base * 0.6f).toLong() else base
                BotPersonality.TILTING -> base + (consecutiveWrong * 150L)
                else -> base
            }
        }
    }

    private val botStates = HashMap<String, BotState>()

    // ─────────────────────────────────────────────────────────────────────────
    // LIFECYCLE
    // ─────────────────────────────────────────────────────────────────────────

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        logStep("onCreate() started")
        setContentView(R.layout.activity_test_mode)

        val prefs       = getSharedPreferences("MY_APP", Context.MODE_PRIVATE)
        userId          = prefs.getInt("user_id", 0)
        currentUserName = prefs.getString("name", "Doctor") ?: "Doctor"

        selectedSubject = intent.getStringExtra("SUBJECT")?.trim()?.takeIf { it.isNotEmpty() }
            ?: intent.getStringExtra("SELECTED_SUBJECT")?.trim()?.takeIf { it.isNotEmpty() }
            ?: prefs.getString("selected_subject_preference", null)
        currentTopic    = intent.getStringExtra("TOPIC")?.trim()?.takeIf { it.isNotEmpty() }
        uniqueId        = normalizeUniqueId(intent.getIntExtra("UNIQUE_ID", 1))
        challengeId     = intent.getStringExtra("CHALLENGE_ID")?.trim().orEmpty()
        isHost          = intent.getBooleanExtra("IS_HOST", true)

        // FIX 3: isChallenge must always be true in real multiplayer so that
        // damagePlayer() writes HP to Firebase
        isChallenge       = intent.getBooleanExtra("IS_CHALLENGE", false) || challengeId.isNotBlank()
        isRealMultiplayer = intent.getBooleanExtra("REAL_MULTIPLAYER", false)

        // Safety: if we have a challenge ID but flag was not passed, treat as real multiplayer
        if (challengeId.isNotBlank() && !isRealMultiplayer) {
            val mode = intent.getStringExtra("MODE") ?: ""
            if (mode == "CHALLENGE") isRealMultiplayer = true
        }

        bindViews()
        setupPowerButtons()
        setupButtons()
        setupBottomNavigation()
        setupLowHealthSystem()
        animateQuestionCardEntrance()

        if (isRealMultiplayer) {
            logStep("Real multiplayer mode — challengeId=$challengeId isHost=$isHost")
            // FIX 3: ensure isChallenge=true so damagePlayer writes to Firebase
            isChallenge = true
            startRealMultiplayerGame()
        } else {
            showMatchmakingPreviewDialog()
            initializeBotStates()
        }
    }

    override fun onDestroy() {
        super.onDestroy()
        testTimer?.cancel()
        uiHandler.removeCallbacksAndMessages(null)
        heartbeatHandler.removeCallbacks(heartbeatRunnable)
        cleanupListeners()
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ENTRANCE ANIMATION
    // ─────────────────────────────────────────────────────────────────────────

    private fun animateQuestionCardEntrance() {
        questionText.alpha       = 0f
        questionText.translationY = 80f
        questionText.animate()
            .alpha(1f).translationY(0f)
            .setDuration(450).setStartDelay(200)
            .setInterpolator(DecelerateInterpolator(2f)).start()

        listOf(optionA, optionB, optionC, optionD).forEachIndexed { i, btn ->
            btn.alpha       = 0f
            btn.translationX = -60f
            btn.animate()
                .alpha(1f).translationX(0f)
                .setDuration(350).setStartDelay((300 + i * 80).toLong())
                .setInterpolator(DecelerateInterpolator(1.8f)).start()
        }

        submitBtn.scaleX = 0.8f; submitBtn.scaleY = 0.8f; submitBtn.alpha = 0f
        submitBtn.animate().scaleX(1f).scaleY(1f).alpha(1f)
            .setDuration(350).setStartDelay(650)
            .setInterpolator(OvershootInterpolator(1.5f)).start()
    }

    // ─────────────────────────────────────────────────────────────────────────
    // REAL MULTIPLAYER ENTRY POINT
    // ─────────────────────────────────────────────────────────────────────────

    private fun startRealMultiplayerGame() {
        if (challengeId.isBlank()) {
            Toast.makeText(this, "Invalid challenge ID", Toast.LENGTH_SHORT).show()
            finish()
            return
        }
        setupClassicFirebaseSession()
        registerCurrentUserReal()
        gameStarted = true
        startTimer(15 * 60 * 1000L)
        observeChallengeMetaAndStartQuestions()
        heartbeatHandler.post(heartbeatRunnable)
    }

    private fun setupClassicFirebaseSession() {
        val ref = FirebaseDatabase.getInstance().getReference("challenges").child(challengeId)
        challengeRootRef    = ref
        challengePlayersRef = ref.child("players")
        questionOrderRef    = ref.child("question_ids")
        isBotMatch = !isRealMultiplayer

        // Only host should overwrite status/timestamp — guest just reads
        if (isHost) {
            challengeRootRef.child("status").setValue("started")
            challengeRootRef.child("created_at").setValue(ServerValue.TIMESTAMP)
            challengeRootRef.child("isBotMatch").setValue(isBotMatch)
        }

        challengeMetaListener?.let { challengeRootRef.removeEventListener(it) }
        challengeMetaListener = object : ValueEventListener {
            override fun onDataChange(snapshot: DataSnapshot) {
                if (selectedSubject.isNullOrBlank())
                    selectedSubject = snapshot.child("subject").getValue(String::class.java)
                if (currentTopic.isNullOrBlank())
                    currentTopic = snapshot.child("topic").getValue(String::class.java)
                // Re-confirm host status from Firebase in case it changed
                val hostId = snapshot.child("hostId").getValue(String::class.java)
                if (hostId != null) isHost = (hostId == userId.toString())
            }
            override fun onCancelled(error: DatabaseError) {
                logError("challengeMetaListener cancelled: ${error.message}")
            }
        }
        challengeRootRef.addValueEventListener(challengeMetaListener!!)
    }

    private fun observeChallengeMetaAndStartQuestions() {
        challengeRootRef.get()
            .addOnSuccessListener { snapshot ->
                if (selectedSubject.isNullOrBlank())
                    selectedSubject = snapshot.child("subject").getValue(String::class.java)
                if (currentTopic.isNullOrBlank())
                    currentTopic = snapshot.child("topic").getValue(String::class.java)
                if (selectedSubject.isNullOrBlank()) selectedSubject = "NEET PG"

                if (isHost) ensureQuestionListForChallengeHost()
                else        waitForSharedQuestionList()

                setupPlayersListener()
            }
            .addOnFailureListener { e ->
                logError("Failed to read challenge meta", e)
                if (selectedSubject.isNullOrBlank()) selectedSubject = "NEET PG"
                if (isHost) ensureQuestionListForChallengeHost()
                else        waitForSharedQuestionList()
                setupPlayersListener()
            }
    }

    private fun registerCurrentUserReal() {
        if (!::challengePlayersRef.isInitialized) return
        challengePlayersRef.child(userId.toString()).get().addOnSuccessListener { snapshot ->
            if (!snapshot.exists()) {
                challengePlayersRef.child(userId.toString()).setValue(
                    hashMapOf(
                        "name" to currentUserName, "hp" to 100, "score" to 0,
                        "image" to "", "skin" to "warrior",
                        "isFinished" to false, "isBot" to false
                    )
                )
            }
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // BOT MATCHMAKING (single-player path)
    // ─────────────────────────────────────────────────────────────────────────

    private fun showMatchmakingPreviewDialog() {
        preGenerateBots()
        val subjectText = selectedSubject ?: "NEET PG"
        
        val progressDialog = AlertDialog.Builder(this)
            .setTitle("⚔ Finding Match")
            .setMessage("Searching for opponents online...\n\nSubject: $subjectText")
            .setCancelable(false)
            .show()

        uiHandler.postDelayed({
            if (isFinishing) return@postDelayed
            progressDialog.dismiss()
            
            val foundDialog = AlertDialog.Builder(this)
                .setTitle("⚔ Match Found!")
                .setMessage(buildString {
                    append("Opponents connected:\n")
                    append("• YOU (Dr. $currentUserName)\n")
                    botStates.values.forEach { append("• Dr. ${it.name}\n") }
                })
                .setCancelable(false)
                .show()
                
            uiHandler.postDelayed({
                if (isFinishing) return@postDelayed
                foundDialog.dismiss()
                startGameAfterConfirmation()
            }, 2000)
            
        }, 3000)
    }

    private fun initializeBotStates() {
        if (botStates.isNotEmpty()) return
        val personalities = BotPersonality.entries.toList().shuffled()

        // Pick 3 unique names from the pool
        val randomNames = BOT_NAME_POOL.shuffled().take(3)

        val bots = listOf(
            BotState("BOT_A", randomNames[0], "mage",     0.65f, 4000, 9000, personalities[0]),
            BotState("BOT_B", randomNames[1], "assassin", 0.74f, 3500, 8000, personalities[1]),
            BotState("BOT_C", randomNames[2], "tank",     0.58f, 5000, 12000, personalities[2])
        )

        bots.forEach { botStates[it.id] = it }
    }

    private fun preGenerateBots() {
        // Ensure names are picked before the preview dialog is shown
        if (botStates.isNotEmpty()) return
        initializeBotStates()
    }

    private fun startGameAfterConfirmation() {
        if (gameStarted) return
        gameStarted = true
        startTimer(15 * 60 * 1000L)

        // Initialize Firebase refs for UI tracking even in bot matches
        if (challengeId.isBlank()) {
            challengeId = "ARENA_PVP_${userId}_${System.currentTimeMillis()}"
        }
        setupClassicFirebaseSession()
        registerCurrentUser() // This will trigger createHumanAndBots()

        if (!isRealMultiplayer) {
            if (!selectedSubject.isNullOrBlank()) fetchQuestionsBySubjectSinglePlayer(selectedSubject!!)
            else fetchQuestionsByUniqueIdSinglePlayer()
        }
        observeChallengeMetaAndStartQuestions()
    }

