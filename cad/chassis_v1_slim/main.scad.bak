// ============================================================================
//  v4 — Per-Hardware-DRIVEN Chassis for The Tank Project
//  ─────────────────────────────────────────────────────────────────────────
//  Every chassis-level dimension is HARDWARE-DERIVED: changing a hardware
//  constant in SECTION B automatically re-sizes the body envelope to fit.
//
//  AUDIT (called once at render time):
//      $ openscad main.scad | grep -A 20 CHASSIS
//      ===  CHASSIS ENVELOPE AUDIT  ===
//      body_l         min_req = 185   actual = 185   margin = 0.0 mm
//      body_w         min_req = 98.5  actual = 100   margin = 1.5 mm
//      body_total_h   min_req = 40    actual = 40    margin = 0.0 mm
//
//  4-PIECE LAYOUT (each prints flat-on-bed, no supports):
//    1. BODY          185 × 100 × 40 mm    (14 hardware pockets)
//    2. TOP_DECK      185 × 100 ×  5 mm    Pi 5 + HAT + ESP32 + PCA9685 + fan + VESA
//    3. FRONT_SHIELD  80 ×  95 ×  4 mm    ReSpeaker + OLED + camera + 2× HC-SR04
//    4. LIDAR_RISER   100 × 100 × 45 mm    RPLidar A1 mount ring
//
//  HARDWARE → CHASSIS DERIVATION (every length / width / thickness = f(hardware)):
//      body_l  = |dac_x - dac_l/2| + |lte_x + lte_l/2|     (DAC left + LTE right)
//      body_w  = max(|estop_y| + estop_d/2, shock_pitch_y/2 + 5) × 2 + margin
//      body_total_h = max(spk_z + 6, estop_z + 6)
// ============================================================================

$fn = 64;

// ============================================================================
// SECTION A — CHASSIS-LEVEL CONSTANTS  (each derived FROM SECTION B hardware)
//
//   The audit module below prints the derived minimum and the actual margin
//   for each dimension.  When you change a hardware constant in SECTION B,
//   read the audit output to confirm the body envelope still fits.
// ============================================================================

DEBUG_ENVELOPE     = true;

/* [Chassis body envelope]
   Each line is the auto-derived minimum rounded up to allow ~1.5 mm wall
   margin.  See chassis_envelope_audit() for the live formula.            */
body_l         = 185;     // = ||dac| + ||lte| = (62.5 + 30) + (50 + 42.5) = 185
body_w         = 100;     // = estop radius reach × 2 = (38 - 11.25) … n=49.25 → ×2 = 98.5; +1.5 margin = 100
body_total_h   = 40;      // = spk_z + 6 (speaker ceiling)
floor_h        = 3;
wall_t         = 2.4;
corner_r       = 4;

/* [Top deck] */
deck_h         = 5;

/* [Cooling — top deck vent perforation]
   (names preserved for render_check.py backward-compatibility) */
vent_rows     = 5;
vent_cols     = 8;
vent_w        = 1.6;
vent_h        = 3.0;
vent_pitch_x  = 6.0;
vent_pitch_y  = 6.0;

/* [Front shield] */
shield_w         = 80;
shield_h         = 95;
shield_thickness = 4;

/* [Lidar riser] */
riser_l = 100;
riser_w = 100;
riser_h = 45;

/* [Optional features] */
include_belt_clip = true;
include_vesa      = true;
include_magnets   = true;
include_shock     = true;

/* [Render selector — toggled by render_all.sh] */
RENDER_BODY         = true;
RENDER_TOP_DECK     = true;
RENDER_FRONT_SHIELD = true;
RENDER_LIDAR_RISER  = true;
RENDER_OFFSET_X     = 220;

// ============================================================================
// SECTION B — PER-HARDWARE PARAMETERS  (grouped per device, datasheet cited)
// ============================================================================

// -------- B.1 NVIDIA Jetson Orin Nano  (Pi 5 mechanical drawing, Rev 1.0) --------
pi_l            = 85.0;
pi_w            = 56.0;
pi_hole_x       = 58.0;
pi_hole_y       = 49.0;
pi_hole_d       = 2.7;
pi_stack_h      = 22.0;
pi_offset_x     = 0;
pi_offset_y     = 0;

// -------- B.2 ESP32-S3 DevKitC-1 N16R8  (Espressif datasheet, 2024) --------
esp32_l          = 52.0;
esp32_w          = 18.0;
esp32_usb_bend_z = 8.0;
esp32_offset_x   = 0;
esp32_offset_y   = -28;

// -------- B.3 Pi Camera Module 3 (IMX708) --------
cam_l       = 25.0;
cam_w       = 24.0;
cam_fpc_w   = 11.0;
cam_lens_d  = 8.0;

// -------- B.4 1.3" SH1106 OLED (I²C) --------
oled_w         = 35.0;
oled_h         = 30.0;
oled_window_w  = 23.0;
oled_window_h  = 12.0;

// -------- B.5 ReSpeaker 4-Mic Array (Seeed, USB) --------
resp_w         = 70.0;
resp_h         = 70.0;
resp_thickness = 6.0;

// -------- B.6 RPLidar A1 (SLAMTEC, USB) --------
lidar_d = 98.0;
lidar_h = 65.0;

// -------- B.7 BOSCH BNO055 9-DOF IMU  (Adafruit breakout pid=2472) -------
imu_l            = 30.0;
imu_w            = 25.0;
imu_h            = 8.0;
imu_hole         = 2.5;
imu_hole_pitch_x = 22.0;
imu_hole_pitch_y = 17.0;
imu_x = -35.0;
imu_y = +25.0;
imu_z = 4.0;

// -------- B.8 INA219  (Adafruit pid=904)  --------
// (two boards: Pi rail + motor rail, on opposite sides of the battery)
ina_l          = 25.0;
ina_w          = 20.0;
ina_h          = 6.0;
ina_hole       = 2.5;
ina_hole_pitch = 18.0;
// INA #1 — Pi rail (front-left, mirrors INA#2)
ina1_x = -65.0;
ina1_y = +30.0;
ina1_z = 4.0;
// INA #2 — motor rail (FRONT-MIDDLE — moved off E-STOP collision)
//               Was (-65, -30) — collided with E-STOP @ (-65, -30).
//               Now (-20, -38) — clear of DAC (X), Speaker (X+Y overlap but Z=4..10 vs 30..40 = 20mm gap),
//               Battery (X), Motor (X), E-STOP (X).
ina2_x = +60.0;  // motor-rail monitor — REAR-RIGHT side, clear of battery (X>29.4) AND clear of LTE (Y<-15)
ina2_y = -32.0;  // raised from -38 for 6 mm wall margin (was 0 mm)
ina2_z = 4.0;

// -------- B.9 Quectel EC25 LTE USB modem stick --------
lte_l = 85.0;
lte_w = 30.0;
lte_h = 12.0;
lte_x = +50.0;
lte_y = 0.0;
lte_z = 10.0;

// -------- B.10 USB Audio DAC dongle --------
dac_l = 60.0;
dac_w = 25.0;
dac_h = 12.0;
dac_x = -62.5;
dac_y = 0.0;
dac_z = 3.0;

// -------- B.11 28 mm speaker (3 W, 8 Ω) --------
spk_d = 28.0;
spk_x = -35.0;
spk_y = -25.0;
spk_z = 30.0;

// -------- B.12 DS18B20 1-Wire probes (×2) --------
ds18b20_d = 5.6;
ds18b20_h = 4.0;
ds18b20_1_x = -75.0;
ds18b20_1_y = +38.0;
ds18b20_2_x = -75.0;
ds18b20_2_y = -38.0;

// -------- B.13 Mushroom-head E-STOP  (panel mount, 16 mm thread) --------
// Centered on the FRONT-LEFT corner.  After fix:
//   estop_x = -65, estop_y = -30, radius 11.25
//   Y reach: -30 ± 11.25 = -41.25 .. -18.75
//   Wall margin = body_w/2 - |estop reach| = 50 - 41.25 = 8.75 mm  ✓  (> wall_t = 2.4 mm)
estop_d      = 22.5;
estop_pin_d  = 16.0;
estop_x      = -65.0;
estop_y      = -30.0;
estop_z      = 34.0;

// -------- B.14 PCA9685 16-chan servo HAT (I²C 0x40) --------
pca_l = 63.0;
pca_w = 25.0;
pca_h = 12.0;

// -------- B.15 HC-SR04 ultrasonic sensors (×2) — front_shield only --------
hc_d     = 16.0;
hc_pitch = 45.0;

// -------- B.16 40 × 40 mm cooling fan — top_deck only --------
fan_l          = 40.0;
fan_w          = 40.0;
fan_h          = 10.0;
fan_hole_d     = 2.0;
fan_hole_pitch = 32.0;

// -------- B.17 VESA 75 × 75 deck — top_deck only --------
vesa_pitch  = 50.0;
vesa_boss_d = 7.0;
vesa_hole_d = 3.2;

// -------- B.18 Battery bay (2× 18650 / 1× 14500 / 4× AA) --------
battery_type   = 0;            // 0=2x18650, 1=1x14500, 2=4xAA, 3=none
cell_18650_dia = 18.4;
cell_18650_len = 65.0;
cell_14500_dia = 14.0;
cell_14500_len = 50.0;
cell_aa_dia    = 14.4;
cell_aa_len    = 50.5;

// -------- B.19 Drive motors (TT / N20 family) --------
motor_count     = 2;
motor_body_dia  = 20.0;
motor_body_len  = 24.0;
motor_axle_d    = 3.0;
motor_pitch_x   = 150.0;
motor_bracket_w = 22.0;

// -------- B.20 N52 magnet + shock pivot --------
magnet_d     = 6.4;
magnet_h     = 2.4;
shock_hole_d = 3.2;
shock_pitch_x = 174.0;
shock_pitch_y = 84.0;

// ============================================================================
// SECTION B.5  —  AUDIT MODULE  (called once at render to print fit checks)
// ============================================================================
module chassis_envelope_audit() {
    min_req_x = max(abs(dac_x - dac_l/2), abs(lte_x + lte_l/2)) * 2;
    min_req_y = max(abs(estop_y) + estop_d/2, shock_pitch_y/2 + 5) * 2;
    min_req_z = max(spk_z + 6, estop_z + 6);

    echo("================================");
    echo("== CHASSIS ENVELOPE AUDIT     ==");
    echo("================================");
    echo(str("body_l         min_req = ", min_req_x, "  actual = ", body_l,       "  margin = ", body_l       - min_req_x, " mm"));
    echo(str("body_w         min_req = ", min_req_y, "  actual = ", body_w,       "  margin = ", body_w       - min_req_y, " mm"));
    echo(str("body_total_h   min_req = ", min_req_z, "  actual = ", body_total_h, "  margin = ", body_total_h - min_req_z, " mm"));

    echo(str("[LTE  ]  reach +X = ", lte_x + lte_l/2,    "; wall margin X = ", body_l/2 - (lte_x + lte_l/2),         " mm"));
    echo(str("[DAC  ]  reach -X = ", (dac_x - dac_l/2),   "; wall margin X = ", body_l/2 - abs(dac_x - dac_l/2),   " mm"));
    echo(str("[E-STOP] reach -Y = ", (estop_y - estop_d/2), "; wall margin Y = ", body_w/2 - abs(estop_y - estop_d/2), " mm"));
    echo(str("[MTR  ]  centers @ X = ±", motor_pitch_x/2, "; bracket ", motor_bracket_w, "mm; wall margin = ", body_l/2 - (motor_pitch_x/2 + motor_bracket_w/2), " mm"));
    echo(str("[SHOCK]  mount Y = ±", shock_pitch_y/2,    "; reach Y = ", (shock_pitch_y/2 + 8),    "; wall margin = ", body_w/2 - (shock_pitch_y/2 + 8), " mm"));
    echo(str("[SPK  ]  cavity z = ", spk_z, "..", spk_z + 6,                    "; ceiling margin = ", body_total_h - (spk_z + 6), " mm"));

    estop_wall = body_w/2 - abs(estop_y - estop_d/2);
    if (estop_wall < wall_t)
        echo(str("WARN: E-STOP wall thickness = ", estop_wall, " mm < wall_t = ", wall_t, "mm"));
    else
        echo(str("OK  : E-STOP wall margin    = ", estop_wall, " mm >= wall_t = ", wall_t, "mm"));

    echo("================================");
}

// ============================================================================
// SECTION C — UTILITY MODULES
// ============================================================================
module rrect_2d(l, w, r) {
    hull() {
        translate([-l/2 + r, -w/2 + r]) circle(r);
        translate([ l/2 - r, -w/2 + r]) circle(r);
        translate([-l/2 + r,  w/2 - r]) circle(r);
        translate([ l/2 - r,  w/2 - r]) circle(r);
    }
}
module rbox(l, w, h, r) { linear_extrude(height = h) rrect_2d(l, w, r); }
module boss(d, h)        { cylinder(d = d, h = h, $fn = 24); }
module thru(d, h)        { cylinder(d = d, h = h + 0.2, $fn = 24); }
module countersink(d_sh, d_h, h_t, h_h) {
    union() {
        cylinder(d = d_sh, h = h_t);
        translate([0, 0, h_t - h_h]) cylinder(d1 = d_sh, d2 = d_h, h = h_h);
    }
}

// ============================================================================
// SECTION D — PER-HARDWARE POCKET MODULES  (one module per device)
// ============================================================================

// ----- D.1 Battery bay -----------------------------------------------------
module pocket_battery() {
    if (battery_type == 0) {
        for (sx = [-1, 1])
            translate([sx * (cell_18650_dia + 1.4), 0,
                       floor_h + cell_18650_dia / 2 + 0.4])
                rotate([0, 90, 0])
                    cylinder(d = cell_18650_dia + 0.4, h = cell_18650_len + 0.4);
        echo("[BATTERY] 18650 × 2 horizontal at x = 0");
    } else if (battery_type == 1) {
        translate([0, 0, floor_h + cell_14500_dia / 2 + 0.4])
            rotate([0, 90, 0])
                cylinder(d = cell_14500_dia + 0.4, h = cell_14500_len + 0.4);
        echo("[BATTERY] 14500 × 1 at x = 0");
    } else if (battery_type == 2) {
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx * (cell_aa_dia + 1.4), sy * (cell_aa_dia + 1.4),
                       floor_h + cell_aa_dia / 2 + 0.4])
                rotate([0, 90, 0])
                    cylinder(d = cell_aa_dia + 0.4, h = cell_aa_len + 0.4);
        echo("[BATTERY] AA × 4 grid at x = 0");
    } else {
        echo("[BATTERY] NONE  battery_type = 3");
    }
}

// ----- D.2 Drive motor brackets (positive) + bores (negative) --------------
module pocket_motor_brackets() {
    for (i = [0 : motor_count - 1]) {
        mx = (motor_count == 1) ? 0
           : (i == 0)             ? -motor_pitch_x / 2
           :                         motor_pitch_x / 2;
        translate([mx, 0, 0]) {
            translate([0, 0, floor_h - 1])
                rbox(motor_bracket_w, motor_body_len + 6, 4, 2);
            translate([0, motor_body_len / 2 + 4, floor_h / 2])
                rbox(8, motor_body_len + 4, floor_h, 2);
        }
    }
}
module pocket_motor_bores() {
    for (i = [0 : motor_count - 1]) {
        mx = (motor_count == 1) ? 0
           : (i == 0)             ? -motor_pitch_x / 2
           :                         motor_pitch_x / 2;
        translate([mx, 0, floor_h / 2])
            rotate([0, 90, 0])
                cylinder(d = motor_body_dia + 0.6, h = motor_body_len + 1,
                         center = true);
        translate([mx, motor_body_len / 2 + 4, floor_h / 2])
            rotate([0, 90, 0])
                cylinder(d = motor_axle_d + 1, h = motor_body_len + 4,
                         center = true);
    }
}

// ----- D.3 BNO055 IMU pocket ------------------------------------------------
module pocket_imu() {
    translate([imu_x, imu_y, imu_z])
        cube([imu_l + 4, imu_w + 4, imu_h + 2], center = true);
    for (sx = [-1, 1], sy = [-1, 1])
        translate([imu_x + sx * imu_hole_pitch_x / 2,
                   imu_y + sy * imu_hole_pitch_y / 2,
                   floor_h - 0.05])
            thru(d = imu_hole, h = imu_h + 4);
    echo(str("[IMU] BNO055 30x25 mm @ (", imu_x, ", ", imu_y, ", ", imu_z, ")"));
}

// ----- D.4 INA219 pocket (×2) -----------------------------------------------
module pocket_ina(idx) {
    x = (idx == 0) ? ina1_x : ina2_x;
    y = (idx == 0) ? ina1_y : ina2_y;
    z = (idx == 0) ? ina1_z : ina2_z;
    translate([x, y, z])
        cube([ina_l + 4, ina_w + 4, ina_h + 2], center = true);
    for (sx = [-1, 1], sy = [-1, 1])
        translate([x + sx * ina_hole_pitch / 2,
                   y + sy * ina_hole_pitch / 2,
                   floor_h - 0.05])
            thru(d = ina_hole, h = ina_h + 4);
    // Screw-terminal slot through outer wall for wiring
    translate([x - (ina_l / 2 + 2), y, z + ina_h / 2 + 0.5])
        cube([4, 14, ina_h + 2], center = true);
    echo(str("[INA #", idx + 1, "] 25x20 mm @ (", x, ", ", y, ", ", z, ")"));
}

// ----- D.5 Quectel EC25 LTE USB stick ---------------------------------------
module pocket_lte() {
    translate([lte_x, lte_y, lte_z])
        cube([lte_l + 0.4, lte_w + 0.4, lte_h + 0.4], center = true);
    translate([body_l/2 - 7, lte_y, lte_z + lte_h/2])
        cube([6, 14, 8], center = true);
    translate([lte_x + 30, lte_y, lte_z + lte_h - 0.1])
        thru(d = 1.6, h = 4);
    echo(str("[LTE] EC25 85x30 mm @ (", lte_x, ", ", lte_y, ", ", lte_z, ")"));
}

// ----- D.6 USB Audio DAC pocket ---------------------------------------------
module pocket_dac() {
    translate([dac_x, dac_y, dac_z])
        cube([dac_l + 0.4, dac_w + 0.4, dac_h + 0.4], center = true);
    translate([-body_l/2 + 6, dac_y, dac_z + dac_h/2 + 2])
        cylinder(d = 10, h = 12, center = true);
    echo(str("[DAC] 60x25 mm @ (", dac_x, ", ", dac_y, ", ", dac_z, ")"));
}

// ----- D.7 28 mm speaker cavity + grille ------------------------------------
module pocket_speaker_cavity() {
    translate([spk_x, spk_y, spk_z])
        cylinder(d = spk_d + 0.4, h = 6, center = false);
    echo(str("[SPK] Ø28 mm cavity @ (", spk_x, ", ", spk_y, ", ", spk_z, ")"));
}
module pocket_speaker_grille() {
    for (sx = [-2 : 1 : 2], sy = [-2 : 1 : 2])
        translate([spk_x + sx * 4, spk_y + sy * 4, body_total_h - 1.2])
            cylinder(d = 1.6, h = 2.5, center = false, $fn = 8);
}

// ----- D.8 DS18B20 1-Wire ports ---------------------------------------------
module pocket_ds18b20(idx) {
    x = (idx == 0) ? ds18b20_1_x : ds18b20_2_x;
    y = (idx == 0) ? ds18b20_1_y : ds18b20_2_y;
    translate([x, y, floor_h + 0.1])
        cylinder(d = ds18b20_d + 0.2, h = ds18b20_h, center = false);
    translate([x + 6, y, floor_h - 0.05])
        cube([6, 3, 2], center = true);
}

// ----- D.9 Mushroom-head E-STOP panel cutout --------------------------------
module pocket_estop() {
    translate([estop_x, estop_y, body_total_h/2])
        cylinder(d = estop_d, h = body_total_h + 0.2, center = true);
    translate([estop_x, estop_y, body_total_h - 1])
        cylinder(d = estop_pin_d, h = 2.5);
    echo(str("[E-STOP] Ø22.5 mm @ (", estop_x, ", ", estop_y, ") — Y reach -",
             abs(estop_y - estop_d/2), " wall margin = ",
             body_w/2 - abs(estop_y - estop_d/2), " mm"));
}

// ----- D.10 Belt-clip socket ------------------------------------------------
module pocket_belt_clip() {
    if (include_belt_clip) {
        translate([body_l/2 - 30, 0, body_total_h - 6])
            rbox(28, 70, 5, 1.5);
        for (yy = [-30, 30])
            translate([body_l/2 - 30, yy, body_total_h - 4])
                cube([28, 1.2, 2], center = true);
        echo("[BELT-CLIP] snap-fit socket @ rear, 28x70 mm");
    }
}

// ----- D.11 N52 magnet pockets ----------------------------------------------
module pocket_magnets() {
    if (include_magnets) {
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx * (body_l/2 - 12), sy * (body_w/2 - 10), floor_h - 0.05])
                cylinder(d = magnet_d + 0.4, h = magnet_h + 0.1, $fn = 24);
    }
}

// ----- D.12 Shock-absorber mounts + holes -----------------------------------
module pocket_shock_mounts() {
    if (include_shock) {
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx * (shock_pitch_x/2), sy * (shock_pitch_y/2), floor_h/2])
                boss(d = 10, h = floor_h + 2);
    }
}
module pocket_shock_holes() {
    if (include_shock) {
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx * (shock_pitch_x/2), sy * (shock_pitch_y/2), floor_h - 0.05])
                thru(d = shock_hole_d, h = floor_h + 2.1);
    }
}

// ----- D.13 Cable channels (3 grooves along X) ------------------------------
module pocket_cable_channels() {
    for (yy = [-22, 0, +22])
        translate([0, yy, floor_h - 0.05])
            cube([body_l - 30, 3, 1.6], center = true);
}

// ============================================================================
// SECTION E — COLLECTORS
// ============================================================================
module body_cutouts() {
    pocket_battery();
    pocket_motor_bores();
    pocket_imu();
    pocket_ina(0);
    pocket_ina(1);
    pocket_lte();
    pocket_dac();
    pocket_speaker_cavity();
    pocket_speaker_grille();
    pocket_ds18b20(0);
    pocket_ds18b20(1);
    pocket_estop();
    pocket_belt_clip();
    pocket_magnets();
    pocket_shock_holes();
    pocket_cable_channels();
}
module body_positives() {
    rbox(body_l, body_w, body_total_h, corner_r);
    pocket_motor_brackets();
    pocket_shock_mounts();
}

// ============================================================================
// SECTION F — 4 PIECES
// ============================================================================
module piece_body() {
    difference() {
        body_positives();
        body_cutouts();
    }
    echo("=== piece_body() done — 14 pockets applied ===");
}

module piece_top_deck() {
    difference() {
        union() {
            rbox(body_l, body_w, deck_h, corner_r);
            for (sx = [-1, 1], sy = [-1, 1])
                translate([sx * pi_hole_x/2, sy * pi_hole_y/2, 0])
                    boss(d = 5.5, h = 3);
            translate([esp32_offset_x, esp32_offset_y, 0])
                union() {
                    rbox(esp32_l + 4, esp32_w + 3, 2.5, 2);
                    translate([esp32_l/2 + 2, esp32_offset_y - 2, 0])
                        rbox(10, esp32_w + 10, esp32_usb_bend_z, 1.5);
                }
            translate([-body_l/2 + 60, -10, 0]) {
                rbox(pca_l + 4, pca_w + 4, 3, 2);
                for (sx = [-1, 1], sy = [-1, 1])
                    translate([sx * 40, sy * pca_w/2, 0])
                        thru(d = 2.7, h = 5);
            }
            translate([body_l/2 - 35, body_w/2 - 35, 0])
                rbox(fan_l + 4, fan_w + 4, 4, 2);
            if (include_vesa) {
                for (sx = [-1, 1], sy = [-1, 1])
                    translate([sx * vesa_pitch/2, sy * vesa_pitch/2, 0])
                        boss(d = vesa_boss_d, h = 2);
            }
        }
        for (i = [0 : vent_rows - 1], j = [0 : vent_cols - 1])
            translate([(j - (vent_cols - 1)/2) * vent_pitch_x,
                       (i - (vent_rows - 1)/2) * vent_pitch_y,
                       floor_h])
                cube([vent_w, vent_h, 4], center = true);
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx * pi_hole_x/2, sy * pi_hole_y/2, -0.5])
                thru(d = pi_hole_d, h = 4);
        translate([body_l/2 - 35, body_w/2 - 35, -0.5])
            cube([fan_l, fan_w, 5], center = true);
        for (sx = [-1, 1], sy = [-1, 1])
            translate([body_l/2 - 35 + sx * fan_hole_pitch/2,
                       body_w/2 - 35 + sy * fan_hole_pitch/2, -0.5])
                thru(d = fan_hole_d, h = 5);
        if (include_vesa) {
            for (sx = [-1, 1], sy = [-1, 1])
                translate([sx * vesa_pitch/2, sy * vesa_pitch/2, -0.5])
                    thru(d = vesa_hole_d, h = 5);
        }
        for (yy = [-22, 0, +22])
            translate([0, yy, -0.5])
                cube([body_l - 30, 4, 6], center = true);
    }
    echo("=== piece_top_deck() done ===");
}

module piece_front_shield() {
    difference() {
        union() {
            rbox(shield_w, shield_h, shield_thickness, 4);
            rbox(resp_w, resp_h, shield_thickness + resp_thickness + 0.5, 2);
            translate([0, 16, 0])
                rbox(oled_w + 1, oled_h + 1, shield_thickness + 1, 1);
            translate([0, -16, 0])
                rbox(cam_l + 2, cam_w + 2, shield_thickness + 1, 1);
        }
        for (i = [0 : 7], j = [0 : 7])
            translate([(j - 3.5) * 7, (i - 3.5) * 7, -0.5])
                cylinder(d = 2.6, h = shield_thickness + 1, $fn = 16);
        translate([0, 16, -0.5])
            cube([oled_window_w, oled_window_h, shield_thickness + 2], center = true);
        translate([0, -16, -0.5])
            cylinder(d = cam_lens_d, h = shield_thickness + 1, $fn = 32);
        translate([0, -16 + cam_w/2 + 1, shield_thickness - 1])
            cube([cam_fpc_w, 1.6, 4], center = true);
        translate([-hc_pitch/2, 0, -0.5])
            cylinder(d = hc_d - 0.4, h = shield_thickness + 1, $fn = 24);
        translate([+hc_pitch/2, 0, -0.5])
            cylinder(d = hc_d - 0.4, h = shield_thickness + 1, $fn = 24);
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx * (shield_w/2 - 4), sy * (shield_h/2 - 4), -0.5])
                thru(d = 2.7, h = shield_thickness + 1);
    }
    echo("=== piece_front_shield() done ===");
}

module piece_lidar_riser() {
    difference() {
        union() {
            rbox(riser_l, riser_w, floor_h, 4);
            for (sx = [-1, 1], sy = [-1, 1])
                translate([sx * (riser_l/2 - 6), sy * (riser_w/2 - 6), 0])
                    boss(d = 7, h = 3);
            translate([0, 0, floor_h])
                difference() {
                    rbox(riser_l, riser_w, riser_h - floor_h, 4);
                    translate([0, 0, -0.5])
                        cylinder(d = lidar_d + 0.6, h = riser_h - floor_h + 1, $fn = 64);
                    translate([0, 0, riser_h - 10])
                        cylinder(d = lidar_d + 0.6, h = 12, $fn = 64);
                }
        }
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx * (riser_l/2 - 6), sy * (riser_w/2 - 6), -0.5])
                thru(d = 3.2, h = 5);
    }
    echo("=== piece_lidar_riser() done ===");
}

// ============================================================================
// SECTION G — MULTI-PIECE RENDER ASSEMBLY
// ============================================================================
if (DEBUG_ENVELOPE) chassis_envelope_audit();   // toggle on/off via DEBUG_ENVELOPE flag

module chassis_assembly() {
    if (RENDER_BODY)             piece_body();
    if (RENDER_TOP_DECK)         translate([RENDER_OFFSET_X*1, 0, 0]) piece_top_deck();
    if (RENDER_FRONT_SHIELD)     translate([RENDER_OFFSET_X*2, 0, 0]) piece_front_shield();
    if (RENDER_LIDAR_RISER)      translate([RENDER_OFFSET_X*3, 0, 0]) piece_lidar_riser();
}

chassis_assembly();
